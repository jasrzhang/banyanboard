# BanyanBoard Frontend Environment Variables
#
# Copy this file to .env.local and fill in values for local development.
# See: https://vitejs.dev/guide/env-and-mode.html

# Backend REST API base URL.
# Default: http://localhost:3001 (local backend dev server)
# In Docker Compose, set to http://backend:3001 or the host-accessible URL.
VITE_API_BASE_URL=http://localhost:3001
